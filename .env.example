# Token do bot criado em https://discord.com/developers/applications
DISCORD_TOKEN=

# Token do bot criado no @BotFather (Telegram)
TELEGRAM_BOT_TOKEN=

# ID do canal do Telegram (ex: -1001234567890) ou @nome_do_canal
TELEGRAM_CHAT_ID=

# IDs dos 5 canais de texto do Discord onde as calls são postadas, separados por vírgula
SOURCE_CHANNEL_IDS=111111111111111111,222222222222222222,333333333333333333,444444444444444444,555555555555555555

# IDs de usuário do Discord autorizados, separados por vírgula (você + o outro admin)
ALLOWED_USER_IDS=111111111111111111,222222222222222222

# Opcionais
PREFIX=!call
CHANNEL_NAME=DUAL CAPITAL
DISCLAIMER=⚠️ Conteúdo informativo. Não é recomendação de investimento. Opere com gestão de risco.
